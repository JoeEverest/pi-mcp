{
  "name": "pi-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A one-tool MCP server for persistent conversations with the Pi coding agent.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeEverest/pi-mcp.git"
  },
  "homepage": "https://github.com/JoeEverest/pi-mcp#readme",
  "bugs": {
    "url": "https://github.com/JoeEverest/pi-mcp/issues"
  },
  "bin": {
    "pi-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
