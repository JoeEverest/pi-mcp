{
  "name": "pi-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A one-tool MCP server for persistent conversations with the Pi coding agent.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoeEverest/pi-mcp.git"
  },
  "homepage": "https://github.com/JoeEverest/pi-mcp#readme",
  "bugs": {
    "url": "https://github.com/JoeEverest/pi-mcp/issues"
  },
  "bin": {
    "pi-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
